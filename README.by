bot = Bot(token=BOT_TOKEN)

# =====================
# Получение последних видео с канала
# =====================
def get_latest_videos(channel_id, max_results=5):
    url = "https://www.googleapis.com/youtube/v3/search"
    params = {
        "key": YOUTUBE_API_KEY,
        "channelId": channel_id,
        "part": "snippet,id",
        "order": "date",
        "maxResults": max_results,
        "type": "video"
    }
    
    try:
        response = requests.get(url, params=params, timeout=15)
        if response.status_code == 200:
            data = response.json()
            videos = []
            for item in data.get("items", []):
                if item["id"]["kind"] == "youtube#video":
                    title = item["snippet"]["title"]
                    video_id = item["id"]["videoId"]
                    url = f"https://youtu.be/{video_id}"
                    videos.append(f"{title}: {url}")
            return videos
        else:
            print(f"Ошибка YouTube API ({channel_id}): {response.status_code}")
            return []
    except Exception as e:
        print(f"Ошибка запроса к YouTube ({channel_id}): {e}")
        return []

# =====================
# Основной цикл бота
# =====================
def main():
    last_message_id = None
    print("Бот запущен! Проверка каждые 60 минут...")

    while True:
        post_text = "🔥 Новые видео и стримы:\n\n"
        active_channels = []

        # Проверяем все каналы
        for name, channel_id in sorted(CHANNELS.items()):
            videos = get_latest_videos(channel_id)
            if videos:
                active_channels.append((name, videos))

        # Формируем пост только из активных каналов
        if active_channels:
            for name, videos in active_channels:
                post_text += f"🎬 {name}:\n"
                post_text += "\n".join(videos) + "\n\n"
        else:
            post_text += "По стримам насрано 😎"

        # Удаляем предыдущее сообщение
        if last_message_id:
            try:
                bot.delete_message(chat_id=CHAT_ID, message_id=last_message_id)
            except TelegramError:
                pass  # Если сообщение уже удалено или ошибка — игнорируем

        # Отправляем новое
        try:
            message = bot.send_message(
                chat_id=CHAT_ID,
                text=post_text,
                disable_web_page_preview=True
            )
            last_message_id = message.message_id
            print(f"[{time.strftime('%H:%M:%S')}] Пост обновлён. Активных каналов: {len(active_channels)}")
        except TelegramError as e:
            print(f"Ошибка отправки в Telegram: {e}")

        # Ждём 1 час до следующей проверки
        time.sleep(3600)

if __name__ == "__main__":
    main()
